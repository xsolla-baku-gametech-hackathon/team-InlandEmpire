TAPPAD_PROVIDER=mock            # or: xsolla
TAPPAD_SERVER_ADDR=127.0.0.1:8080
XSOLLA_PROJECT_ID=315338
XSOLLA_API_KEY=replace-me
XSOLLA_SANDBOX=true
TAPPAD_AUTOPAY=false            # true: pay sandbox orders headless, see scripts/autopay.py
